# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, 32+ chars (e.g. `openssl rand -base64 48`) – signs the session cookie
SESSION_SECRET=

NEXT_PUBLIC_APP_TIME_ZONE=Asia/Jerusalem
# Optional: canonical site URL for share links / metadata
NEXT_PUBLIC_SITE_URL=
