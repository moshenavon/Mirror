# Supabase (database only – Supabase Auth is not used)
NEXT_PUBLIC_SUPABASE_URL=https://kcpbotofdgdrwvuclwck.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Supabase Dashboard → Project Settings → JWT Keys → "Legacy JWT secret" (server only!)
